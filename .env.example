# exchange-mcp-server configuration
# Copy to ~/.config/exchange-mcp/.env (or point EXCHANGE_MCP_ENV_FILE at it) and keep it private.

# --- Connection -------------------------------------------------------------
EXCHANGE_EMAIL=you@example.com
EXCHANGE_SERVER=https://mail.example.com/EWS/Exchange.asmx
# EXCHANGE_AUTODISCOVER=false

# --- Authentication: ntlm | basic | oauth_app | oauth_delegated ---------------
EXCHANGE_AUTH=ntlm
EXCHANGE_PASSWORD=change-me
EXCHANGE_DOMAIN=EXAMPLE
# EXCHANGE_USERNAME=EXAMPLE\you
# EXCHANGE_VERIFY_SSL=true

# Exchange Online (EWS is being retired there - see README)
# EXCHANGE_TENANT_ID=00000000-0000-0000-0000-000000000000
# EXCHANGE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# EXCHANGE_CLIENT_SECRET=           # oauth_app only
# EXCHANGE_TOKEN_CACHE=~/.config/exchange-mcp/token_cache.json

# --- Behaviour --------------------------------------------------------------
EXCHANGE_TIMEZONE=Asia/Taipei
# EXCHANGE_READ_ONLY=false
# EXCHANGE_ALLOW_SEND=true
# Folders whose files may be attached (comma-separated). Empty = attachments disabled.
# EXCHANGE_ATTACHMENT_DIRS=C:\Users\you\Documents\Outgoing
# EXCHANGE_MAX_ATTACHMENT_MB=20
# EXCHANGE_SIGNATURE_DIR=C:\Users\you\AppData\Roaming\Microsoft\Signatures

# --- Rooms: roomlists | catalog | both --------------------------------------
# EXCHANGE_ROOM_SOURCE=both
# EXCHANGE_ROOMS_FILE=~/.config/exchange-mcp/rooms.json
